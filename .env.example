# Public site URL used for canonical metadata and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional PostgreSQL connection. Version 1 uses typed local data.
DATABASE_URL=

# GitHub API token (server-only). Never expose to the client.
GITHUB_TOKEN=
GITHUB_USERNAME=

# AI provider keys (server-only). Portfolio works without these.
AI_API_KEY=
AI_PROVIDER=none

# Optional analytics identifier. Do not put secrets in NEXT_PUBLIC_* vars.
ANALYTICS_ID=
